# Copy to .env.local and fill in. Never commit real keys.

# LLM providers (free tiers). One key per provider is enough; more keys add capacity.
# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY_2=
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_API_KEY_2=

# Optional. The model ladder: tiers separated by ",", models inside a tier by "|".
# Turns rotate over the models and keys of the first tier; a rate-limited or failing one is
# skipped for a while and the same call moves on at once. Default:
# LLM_MODELS=groq:openai/gpt-oss-120b | google:gemini-3.8-flash, groq:qwen/qwen3.8-27b | google:gemini-3.7-flash, groq:openai/gpt-oss-20b | google:gemini-3.5-flash-lite

# Optional. Defaults to the bundled read-only SQLite file (file:data/healtrip.db).
# Point it at a Turso/libSQL URL to move the catalog to a hosted database.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
