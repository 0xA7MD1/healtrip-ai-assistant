# Copy to .env.local and fill in. Never commit real keys.

# LLM providers (free tiers)
# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=

# Models are configuration, not code: "<provider>:<model-id>".
# The fallback is used automatically when the primary is rate-limited or down.
LLM_PRIMARY_MODEL=google:gemini-3.8-flash
LLM_FALLBACK_MODEL=groq:openai/gpt-oss-120b

# Optional. Defaults to the bundled read-only SQLite file (file:data/healtrip.db).
# Point it at a Turso/libSQL URL to move the catalog to a hosted database.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=
